# Backend-only settings. Never prefix secrets with VITE_.
APP_ENV=development
# Relative SQLite paths resolve against the command's working directory.
DATABASE_URL=sqlite:///./npm_wiki.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production: APP_ENV=production; persistent PostgreSQL; exact HTTPS frontend origins.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# ALLOWED_ORIGINS=https://YOUR-FRONTEND.example
BOT_TOKEN=
ADMIN_IDS=
INIT_DATA_MAX_AGE_SECONDS=3600

# Optional browser development login. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Manually enter the token in the development UI. Never commit it or put it in VITE_ env.
# Production refuses to start if DEV_ADMIN_TOKEN is set.
DEV_ADMIN_TOKEN=
DEV_ADMIN_USER_ID=1
