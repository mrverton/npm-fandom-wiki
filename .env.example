# Public frontend configuration. Never put BOT_TOKEN, DATABASE_URL or admin secrets in VITE_*.
# /api uses the same origin: Vite proxies in development; production needs a reverse proxy.
# For a separate backend set its HTTPS origin, e.g. https://api.example.com (no trailing /api needed).
VITE_API_BASE_URL=/api

# 20 seconds by default; configure 60000 for a deployment with a slow cold start.
VITE_API_TIMEOUT_MS=20000

# Development server only; never included in browser code or production bundles.
API_PROXY_TARGET=http://127.0.0.1:8000

# Backend settings belong in backend/.env. See backend/.env.example.
